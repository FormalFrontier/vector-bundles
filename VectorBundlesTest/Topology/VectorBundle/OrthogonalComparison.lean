module

public import VectorBundles.Topology.VectorBundle.OrthogonalComparison
public import VectorBundlesTest.Topology.VectorBundle.OrthogonalProjection
public import VectorBundles.Analysis.InnerProductSpace.PositiveForm
public import Mathlib.Tactic.FinCases
public import Mathlib.Tactic.Ring
public import Mathlib.Tactic.Linarith

/-!
# A shear metric on the trivial Euclidean plane bundle

The ambient plane has its original Euclidean norm throughout. The embedded
intrinsic subbundle is the first-coordinate line with its inherited
norm and stock trivial-bundle topology. Pulling the standard pairing back by
`(x, y) ↦ (x + t * y, y)` gives a second continuous Hermitian metric. Its
orthogonal line is generated by `-t • ex + ey`.

The metric's section continuity is checked in the iterated Hom-bundle charts;
the coordinate expression is a polynomial in the original operator spaces.
The projection calculations use the existing total-space projections on sums
of independently verified orthogonal components. The continuous-linear projection
fields are read in the Hom topology from those same charts and evaluated on `ey`
using continuous bundle evaluation.

The Hom-chart argument follows Sébastien Gouëzel's standard metric constructor,
using Mathlib's Hom-bundle construction by Heather Macbeth and Floris van Doorn
and its stock trivial-bundle charts. The finite-dimensional boundedness argument
is supplied by the positive-form API.
-/

@[expose] public section

noncomputable section

open Bundle
open scoped ComplexConjugate

namespace ShearMetricComparison

/-- The Euclidean plane, with its original L2 geometry. -/
abbrev Plane := EuclideanSpace ℝ (Fin 2)

/-- The original stock trivial plane bundle over the real line. -/
abbrev Ambient := Bundle.Trivial ℝ Plane

/-- The intrinsic first-coordinate line, with its inherited norm. -/
abbrev Line := CoordinateLineBundle.line ℝ

/-- The constant intrinsic coordinate-line family. -/
abbrev S : ∀ t : ℝ, Submodule ℝ (Ambient t) := fun _ ↦ Line

/-- The first coordinate unit vector. -/
def ex : Plane := EuclideanSpace.single 0 1

/-- The second coordinate unit vector. -/
def ey : Plane := EuclideanSpace.single 1 1

/-- The rank-one nilpotent sending the second coordinate unit to the first. -/
def shearNilpotent : Plane →L[ℝ] Plane :=
  (EuclideanSpace.proj (1 : Fin 2)).smulRight ex

/-- A shear, defined as an operator on the original Euclidean plane. -/
def shear (t : ℝ) : Plane →L[ℝ] Plane :=
  ContinuousLinearMap.id ℝ Plane + t • shearNilpotent

@[simp]
theorem shear_apply_zero (t : ℝ) (v : Plane) : shear t v 0 = v 0 + t * v 1 := by
  simp [shear, shearNilpotent, ex]

@[simp]
theorem shear_apply_one (t : ℝ) (v : Plane) : shear t v 1 = v 1 := by
  simp [shear, shearNilpotent, ex]

/-- The nilpotent has square zero, independently of any inverse construction. -/
theorem shearNilpotent_sq (v : Plane) : shearNilpotent (shearNilpotent v) = 0 := by
  simp [shearNilpotent, ex]

/-- Injectivity of the shear follows from its two coordinates. -/
theorem shear_injective (t : ℝ) : Function.Injective (shear t) := by
  intro v w h
  have hy := congrArg (fun z : Plane ↦ z 1) h
  have hx := congrArg (fun z : Plane ↦ z 0) h
  simp only [shear_apply_one] at hy
  simp only [shear_apply_zero] at hx
  rw [hy] at hx
  ext i
  fin_cases i
  · exact add_right_cancel hx
  · exact hy

/-- Composition of the standard pairing with two original-norm operators. -/
def pairing (U W : Plane →L[ℝ] Plane) : Plane →L⋆[ℝ] Plane →L[ℝ] ℝ :=
  (innerSL ℝ).bilinearComp U W

/-- The independently constructed second metric form. -/
def shearForm (t : ℝ) : Plane →L⋆[ℝ] Plane →L[ℝ] ℝ :=
  pairing (shear t) (shear t)

@[simp]
theorem shearForm_apply (t : ℝ) (v w : Plane) :
    shearForm t v w = inner ℝ (shear t v) (shear t w) := rfl

/-- The original inner product written in the two coordinates. -/
theorem inner_coordinates (v w : Plane) :
    inner ℝ v w = v 0 * w 0 + v 1 * w 1 := by
  simp only [PiLp.inner_apply, Fin.sum_univ_two, Real.inner_apply]

/-- The shear form has matrix `[[1,t],[t,1+t²]]` in the original coordinates. -/
theorem shearForm_coordinates (t : ℝ) (v w : Plane) :
    shearForm t v w = (v 0 + t * v 1) * (w 0 + t * w 1) + v 1 * w 1 := by
  rw [shearForm_apply, inner_coordinates, shear_apply_zero, shear_apply_zero,
    shear_apply_one, shear_apply_one]

/-- Hermitian symmetry for the supplied shear form. -/
theorem shearForm_symm (t : ℝ) (v w : Plane) :
    conj (shearForm t w v) = shearForm t v w :=
  inner_conj_symm (shear t v) (shear t w)

/-- Strict positivity uses injectivity, not an assumed inverse. -/
theorem shearForm_pos (t : ℝ) (v : Plane) (hv : v ≠ 0) :
    0 < RCLike.re (shearForm t v v) := by
  have hn : shear t v ≠ 0 := by
    intro h
    apply hv
    apply shear_injective t
    simpa only [map_zero] using h
  rw [shearForm_apply, inner_self_eq_norm_sq]
  exact sq_pos_of_pos (norm_pos_iff.mpr hn)

/-- The operator-valued polynomial for the variable form, in the original norms. -/
theorem shearForm_polynomial (t : ℝ) :
    shearForm t =
      pairing (ContinuousLinearMap.id ℝ Plane) (ContinuousLinearMap.id ℝ Plane) +
        t • (pairing shearNilpotent (ContinuousLinearMap.id ℝ Plane) +
          pairing (ContinuousLinearMap.id ℝ Plane) shearNilpotent) +
        t ^ 2 • pairing shearNilpotent shearNilpotent := by
  refine ContinuousLinearMap.ext (σ₁₂ := starRingEnd ℝ)
    (M₁ := Plane) (M₂ := Plane →L[ℝ] ℝ) fun v ↦ ?_
  refine ContinuousLinearMap.ext (σ₁₂ := RingHom.id ℝ)
    (M₁ := Plane) (M₂ := ℝ) fun w ↦ ?_
  change inner ℝ (shear t v) (shear t w) =
    inner ℝ v w + t * (inner ℝ (shearNilpotent v) w + inner ℝ v (shearNilpotent w)) +
      t ^ 2 * inner ℝ (shearNilpotent v) (shearNilpotent w)
  simp only [shear, add_apply, smul_apply, ContinuousLinearMap.id_apply,
    inner_add_left, inner_add_right, real_inner_smul_left, real_inner_smul_right]
  ring

/-- Continuity in the normed space of forms. -/
theorem continuous_shearForm : Continuous shearForm := by
  -- Use the stock continuous addition on the original bounded-convergence topology.
  let hinner : IsTopologicalAddGroup (Plane →L[ℝ] ℝ) :=
    ContinuousLinearMap.isTopologicalAddGroup (σ := RingHom.id ℝ) (E := Plane) (F := ℝ)
  let houter : IsTopologicalAddGroup (Plane →L⋆[ℝ] Plane →L[ℝ] ℝ) :=
    ContinuousLinearMap.isTopologicalAddGroup (σ := starRingEnd ℝ) (E := Plane)
      (F := Plane →L[ℝ] ℝ)
  have hadd : Continuous (fun p :
      (Plane →L⋆[ℝ] Plane →L[ℝ] ℝ) × (Plane →L⋆[ℝ] Plane →L[ℝ] ℝ) ↦ p.1 + p.2) :=
    houter.toContinuousAdd.1
  have hconstant : Continuous (fun _ : ℝ ↦
      pairing (ContinuousLinearMap.id ℝ Plane) (ContinuousLinearMap.id ℝ Plane)) :=
    continuous_const
  have hlinear : Continuous (fun t : ℝ ↦
      t • (pairing shearNilpotent (ContinuousLinearMap.id ℝ Plane) +
        pairing (ContinuousLinearMap.id ℝ Plane) shearNilpotent)) :=
    continuous_id.smul continuous_const
  have hquadratic : Continuous (fun t : ℝ ↦
      t ^ 2 • pairing shearNilpotent shearNilpotent) :=
    (continuous_id.pow 2).smul continuous_const
  exact (hadd.comp₂ (hadd.comp₂ hconstant hlinear) hquadratic).congr
    fun t ↦ (shearForm_polynomial t).symm

/-- The shear pairing is a continuous section of the iterated Hom bundle.
Both Hom charts reduce to the original trivial charts, without identifying the
Hom total topology with a trivial-bundle total topology. -/
theorem continuous_shearForm_section : Continuous
    (fun t : ℝ ↦ TotalSpace.mk' (Plane →L⋆[ℝ] Plane →L[ℝ] ℝ)
      (E := fun t ↦ Ambient t →L⋆[ℝ] Ambient t →L[ℝ] ℝ) t (shearForm t)) := by
  rw [continuous_iff_continuousAt]
  intro x
  rw [FiberBundle.continuousAt_totalSpace]
  refine ⟨continuousAt_id, ?_⟩
  convert! continuous_shearForm.continuousAt (x := x) using 1
  ext t v w
  simp [hom_trivializationAt_apply, ContinuousLinearMap.inCoordinates]

/-- The first supplied metric is the standard metric on the original bundle. -/
def standardMetric : ContinuousHermitianMetric ℝ Plane Ambient :=
  ContinuousHermitianMetric.trivial ℝ ℝ Plane

/-- The second supplied metric, with boundedness in the original Euclidean norm
and continuity in the existing iterated Hom-bundle topology. -/
def shearMetric : ContinuousHermitianMetric ℝ Plane Ambient where
  inner := shearForm
  symm := shearForm_symm
  pos := shearForm_pos
  isVonNBounded t := (shearForm t).isVonNBounded_re_unit_sublevel_of_posDef
    (shearForm_symm t) (shearForm_pos t)
  continuous := continuous_shearForm_section

/-- The standard orthogonal family. -/
abbrev standardComplement (t : ℝ) : Submodule ℝ (Ambient t) :=
  (S t).orthogonalBilin (standardMetric.inner t).toLinearMap₁₂

/-- The shear-orthogonal family. -/
abbrev shearComplement (t : ℝ) : Submodule ℝ (Ambient t) :=
  (S t).orthogonalBilin (shearMetric.inner t).toLinearMap₁₂

/-- The complement model is the rank-difference model, not a chosen
coordinate model for the moving line. -/
abbrev ComplementModel := EuclideanSpace ℝ
  (Fin (Module.finrank ℝ Plane - Module.finrank ℝ Line))

/-- Standard orthogonality, with the subspace vector in the first argument. -/
theorem mem_standardComplement (t : ℝ) (v : Plane) :
    v ∈ standardComplement t ↔ v 0 = 0 := by
  change (∀ s ∈ Line, inner ℝ s v = 0) ↔ v 0 = 0
  constructor
  · intro h
    simpa [ex, EuclideanSpace.inner_single_left] using h ex (by simp [ex, Line])
  · intro hv s hs
    have hs1 := (CoordinateLineBundle.mem_line ℝ s).mp hs
    rw [inner_coordinates, hv, hs1]
    simp

/-- Shear orthogonality is computed independently of the comparison maps. -/
theorem mem_shearComplement (t : ℝ) (v : Plane) :
    v ∈ shearComplement t ↔ v 0 + t * v 1 = 0 := by
  change (∀ s ∈ Line, shearForm t s v = 0) ↔ v 0 + t * v 1 = 0
  constructor
  · intro h
    have hx := h ex (by simp [ex, Line])
    rw [shearForm_coordinates] at hx
    simpa [ex] using hx
  · intro hv s hs
    have hs1 := (CoordinateLineBundle.mem_line ℝ s).mp hs
    rw [shearForm_coordinates, hs1, hv]
    simp

/-- The normalized generator of the moving orthogonal line. -/
def movingNormal (t : ℝ) : Plane := -t • ex + ey

@[simp]
theorem movingNormal_zero (t : ℝ) : movingNormal t 0 = -t := by
  simp [movingNormal, ex, ey]

@[simp]
theorem movingNormal_one (t : ℝ) : movingNormal t 1 = 1 := by
  simp [movingNormal, ex, ey]

/-- The standard complement contains the fixed second coordinate unit. -/
theorem ey_mem_standardComplement (t : ℝ) : ey ∈ standardComplement t := by
  rw [mem_standardComplement]
  simp [ey]

/-- Membership of the moving generator is derived from the second form. -/
theorem movingNormal_mem_shearComplement (t : ℝ) :
    movingNormal t ∈ shearComplement t := by
  rw [mem_shearComplement]
  simp

/-- The second complement really is the line spanned by the moving generator. -/
theorem shearComplement_eq_span (t : ℝ) :
    shearComplement t = Submodule.span ℝ {movingNormal t} := by
  apply le_antisymm
  · intro v hv
    have hv0 := (mem_shearComplement t v).mp hv
    have heq : v = v 1 • movingNormal t := by
      ext i
      fin_cases i
      · change v 0 = v 1 * movingNormal t 0
        rw [movingNormal_zero]
        linarith
      · change v 1 = v 1 * movingNormal t 1
        rw [movingNormal_one, mul_one]
    rw [heq]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_singleton _))
  · exact Submodule.span_le.mpr (by
      intro v hv
      rcases Set.mem_singleton_iff.mp hv with rfl
      exact movingNormal_mem_shearComplement t)

/-- A vector in the intrinsic coordinate line. -/
def lineVector (a : ℝ) : Line := ⟨a • ex, by simp [Line, ex]⟩

/-- The fixed unit as a point of the first complement. -/
def standardNormal (t : ℝ) : standardComplement t :=
  ⟨ey, ey_mem_standardComplement t⟩

/-- The independently calculated generator as a point of the second complement. -/
def shearedNormal (t : ℝ) : shearComplement t :=
  ⟨movingNormal t, movingNormal_mem_shearComplement t⟩

/-- The second total projection sends `ey` to the moving generator. -/
theorem shear_projection_ey (t : ℝ) :
    shearMetric.orthogonalComplementProjectionTotal (G := Line) S
        (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
        (TotalSpace.mk' Plane (E := Ambient) t ey) =
      TotalSpace.mk' ComplementModel t (shearedNormal t) := by
  have hsum : (lineVector t : Plane) + (shearedNormal t : Plane) = ey := by
    change t • ex + (-t • ex + ey) = ey
    simp [neg_smul, ← add_assoc]
  simpa only [hsum] using
    shearMetric.orthogonalComplementProjectionTotal_apply_add (G := Line) S
      (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ) t (lineVector t) (shearedNormal t)

/-- The reverse projection recovers the fixed second coordinate unit. -/
theorem standard_projection_movingNormal (t : ℝ) :
    standardMetric.orthogonalComplementProjectionTotal (G := Line) S
        (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
        (TotalSpace.mk' Plane (E := Ambient) t (movingNormal t)) =
      TotalSpace.mk' ComplementModel t (standardNormal t) := by
  simpa only [lineVector, standardNormal, movingNormal] using
    standardMetric.orthogonalComplementProjectionTotal_apply_add (G := Line) S
      (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ) t (lineVector (-t)) (standardNormal t)

/-- The normalized outputs at zero and one differ in the original ambient fiber,
not merely in the base coordinate of their total-space points. -/
theorem movingNormal_zero_ne_one : movingNormal 0 ≠ movingNormal 1 := by
  intro h
  have h0 := congrArg (fun v : Plane ↦ v 0) h
  simp only [movingNormal_zero, neg_zero] at h0
  linarith

/-- The fixed line and its orthogonal family for the shear metric are
topological complements in the original Euclidean plane. -/
theorem shear_isTopCompl (t : ℝ) : (S t).IsTopCompl (shearComplement t) := by
  refine ⟨shearMetric.orthogonal_isCompl S t, ?_⟩
  exact LinearMap.continuous_of_finiteDimensional _

local notation "Qₛ" => (fun t : ℝ ↦
  Submodule.projectionOntoL (S t) (shearComplement t) (shear_isTopCompl t))
local notation "Pₛ" => (fun t : ℝ ↦
  Submodule.projectionL (S t) (shearComplement t) (shear_isTopCompl t))
local notation "P꜀" => (fun t : ℝ ↦
  Submodule.projectionL (shearComplement t) (S t)
    (Submodule.IsTopCompl.symm (shear_isTopCompl t)))

/-- Evaluating the three continuous projector fields on the fixed section `ey`
gives the intrinsic vector `lineVector t` and the ambient vectors `t • ex` and
`-t • ex + ey`. The ambient values sum to `ey`, and the second value moves in
the original plane, not merely in the base coordinate. -/
theorem continuous_shear_projector_evaluations :
    Continuous (fun t : ℝ ↦ TotalSpace.mk' Line (E := fun t ↦ S t) t (lineVector t)) ∧
    Continuous (fun t : ℝ ↦ TotalSpace.mk' Plane (E := Ambient) t (t • ex)) ∧
    Continuous (fun t : ℝ ↦ TotalSpace.mk' Plane (E := Ambient) t (movingNormal t)) ∧
    (∀ t : ℝ, Pₛ t ey = t • ex ∧ P꜀ t ey = movingNormal t ∧
      Pₛ t ey + P꜀ t ey = ey) ∧
    P꜀ 0 ey ≠ P꜀ 1 ey := by
  -- Bind the Hom topology explicitly, even though both underlying families are constant.
  have hQ : @Continuous ℝ _ inferInstance
      (Bundle.ContinuousLinearMap.topologicalSpaceTotalSpace
        (RingHom.id ℝ) Plane Ambient Line (fun t ↦ S t))
      (fun t ↦ TotalSpace.mk' (Plane →L[ℝ] Line) t (Qₛ t)) :=
    shearMetric.continuous_orthogonalProjectionOntoL (G := Line) S
      (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
  have hP : @Continuous ℝ _ inferInstance
      (Bundle.ContinuousLinearMap.topologicalSpaceTotalSpace
        (RingHom.id ℝ) Plane Ambient Plane Ambient)
      (fun t ↦ TotalSpace.mk' (Plane →L[ℝ] Plane) t (Pₛ t)) :=
    shearMetric.continuous_orthogonalProjectionL (G := Line) S
      (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
  have hC : @Continuous ℝ _ inferInstance
      (Bundle.ContinuousLinearMap.topologicalSpaceTotalSpace
        (RingHom.id ℝ) Plane Ambient Plane Ambient)
      (fun t ↦ TotalSpace.mk' (Plane →L[ℝ] Plane) t (P꜀ t)) :=
    shearMetric.continuous_orthogonalComplementProjectionL (G := Line) S
      (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
  have hey : Continuous (fun t : ℝ ↦ TotalSpace.mk' Plane (E := Ambient) t ey) :=
    (Bundle.Trivial.homeomorphProd ℝ Plane).symm.continuous.comp
      (continuous_id.prodMk continuous_const)
  have hQey := hQ.clm_bundle_apply hey
  have hPey := hP.clm_bundle_apply hey
  have hCey := hC.clm_bundle_apply hey
  have hsum (t : ℝ) : (lineVector t : Plane) + (shearedNormal t : Plane) = ey := by
    change t • ex + (-t • ex + ey) = ey
    simp [neg_smul, ← add_assoc]
  have hQvalue (t : ℝ) : Qₛ t ey = lineVector t := by
    rw [← hsum t, map_add, Submodule.projectionOntoL_apply_left,
      Submodule.projectionOntoL_apply_right, add_zero]
  have hPvalue (t : ℝ) : Pₛ t ey = t • ex := by
    exact congrArg Subtype.val (hQvalue t)
  have hCvalue (t : ℝ) : P꜀ t ey = movingNormal t := by
    have ht := shear_projection_ey t
    rw [ContinuousHermitianMetric.orthogonalComplementProjectionTotal_apply] at ht
    have hv := (TotalSpace.mk_inj (F := ComplementModel)
      (E := fun t ↦ shearComplement t)).mp ht
    exact congrArg Subtype.val hv
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · exact hQey.congr fun t ↦ congrArg
      (fun v : S t ↦ TotalSpace.mk' Line (E := fun t ↦ S t) t v) (hQvalue t)
  · exact hPey.congr fun t ↦ congrArg (TotalSpace.mk' Plane (E := Ambient) t) (hPvalue t)
  · exact hCey.congr fun t ↦ congrArg (TotalSpace.mk' Plane (E := Ambient) t) (hCvalue t)
  · intro t
    exact ⟨hPvalue t, hCvalue t,
      Submodule.projectionL_add_projectionL_eq_self (shear_isTopCompl t) ey⟩
  · rw [hCvalue, hCvalue]
    exact movingNormal_zero_ne_one

local notation "C₁" => (fun t : ℝ ↦ Subtype (fun v : Ambient t ↦ v ∈ standardComplement t))
local notation "C₂" => (fun t : ℝ ↦ Subtype (fun v : Ambient t ↦ v ∈ shearComplement t))
local notation "tC₁" => TopologicalSpace.induced
  (fun p : TotalSpace ComplementModel C₁ ↦
    TotalSpace.mk' Plane (E := Ambient) (TotalSpace.proj p)
      (Subtype.val (TotalSpace.snd p))) inferInstance
local notation "tC₂" => TopologicalSpace.induced
  (fun p : TotalSpace ComplementModel C₂ ↦
    TotalSpace.mk' Plane (E := Ambient) (TotalSpace.proj p)
      (Subtype.val (TotalSpace.snd p))) inferInstance

/-- The comparison homeomorphism, with its complement total spaces and
ambient-induced total topologies. No coordinates are used to define this map. -/
def comparison : @Homeomorph
    (TotalSpace ComplementModel C₁) (TotalSpace ComplementModel C₂) tC₁ tC₂ :=
  standardMetric.orthogonalComplementHomeomorph (G := Line) shearMetric S
    (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)

/-- The forward map uses the second metric's complement projection. -/
theorem comparison_apply_projection (p : TotalSpace ComplementModel C₁) :
    comparison p = shearMetric.orthogonalComplementProjectionTotal (G := Line) S
      (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
      (TotalSpace.mk' Plane (E := Ambient) (TotalSpace.proj p)
        (Subtype.val (TotalSpace.snd p))) :=
  standardMetric.orthogonalComplementHomeomorph_apply (G := Line) shearMetric S
    (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ) p

/-- The inverse uses the first metric's complement projection. -/
theorem comparison_symm_apply_projection (p : TotalSpace ComplementModel C₂) :
    @Homeomorph.symm (TotalSpace ComplementModel C₁) (TotalSpace ComplementModel C₂)
      tC₁ tC₂ comparison p = standardMetric.orthogonalComplementProjectionTotal (G := Line) S
      (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
      (TotalSpace.mk' Plane (E := Ambient) (TotalSpace.proj p)
        (Subtype.val (TotalSpace.snd p))) :=
  standardMetric.orthogonalComplementHomeomorph_symm_apply (G := Line) shearMetric S
    (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ) p

/-- Both comparison maps preserve the base coordinate. -/
theorem comparison_preserves_base
    (p : TotalSpace ComplementModel C₁) (q : TotalSpace ComplementModel C₂) :
    (comparison p).proj = p.proj ∧
      (@Homeomorph.symm (TotalSpace ComplementModel C₁) (TotalSpace ComplementModel C₂)
        tC₁ tC₂ comparison q).proj = q.proj :=
  ⟨standardMetric.orthogonalComplementHomeomorph_proj (G := Line) shearMetric S
      (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ) p,
    standardMetric.orthogonalComplementHomeomorph_symm_proj (G := Line) shearMetric S
      (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ) q⟩

/-- The comparison sends the fixed unit to the independently calculated
moving vector, by the projection-on-sums formula. -/
theorem comparison_normal (t : ℝ) :
    comparison (TotalSpace.mk' ComplementModel (E := C₁) t (standardNormal t)) =
      TotalSpace.mk' ComplementModel (E := C₂) t (shearedNormal t) := by
  rw [comparison_apply_projection]
  exact shear_projection_ey t

/-- Its inverse recovers the fixed unit by the first metric's projection. -/
theorem comparison_symm_normal (t : ℝ) :
    @Homeomorph.symm (TotalSpace ComplementModel C₁) (TotalSpace ComplementModel C₂)
      tC₁ tC₂ comparison (TotalSpace.mk' ComplementModel (E := C₂) t (shearedNormal t)) =
      TotalSpace.mk' ComplementModel (E := C₁) t (standardNormal t) := by
  rw [comparison_symm_apply_projection]
  exact standard_projection_movingNormal t

/-- The quotient-derived fiber equivalence has the same calculated value as the
total-space comparison. -/
theorem fiber_comparison_normal (t : ℝ) :
    standardMetric.orthogonalComplementEquiv shearMetric S t (standardNormal t) =
      shearedNormal t := by
  have h := standardMetric.orthogonalComplementHomeomorph_apply_mk (G := Line)
    shearMetric S (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ) t (standardNormal t)
  exact (TotalSpace.mk_inj (F := ComplementModel) (E := C₂)).mp
    (h.symm.trans (comparison_normal t))

/-- The inverse fiber equivalence also agrees with the calculated first-metric projection. -/
theorem fiber_comparison_symm_normal (t : ℝ) :
    (standardMetric.orthogonalComplementEquiv shearMetric S t).symm (shearedNormal t) =
      standardNormal t := by
  have h := standardMetric.orthogonalComplementHomeomorph_symm_apply_mk (G := Line)
    shearMetric S (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ) t (shearedNormal t)
  exact (TotalSpace.mk_inj (F := ComplementModel) (E := C₁)).mp
    (h.symm.trans (comparison_symm_normal t))

/-- The fiber API identifies the moving output by its class modulo the original
intrinsic line. -/
example (t : ℝ) : ey - (shearedNormal t : Plane) ∈ S t := by
  exact (standardMetric.orthogonalComplementEquiv_eq_iff_sub_mem shearMetric S t
    (standardNormal t) (shearedNormal t)).mp (fiber_comparison_normal t)

/-- Movement is visible in the original ambient fiber coordinates of the
comparison map, not just in its varying base coordinate. -/
theorem comparison_moves_in_ambient :
    ((comparison (TotalSpace.mk' ComplementModel (E := C₁) 0 (standardNormal 0))).2 : Plane) ≠
      ((comparison (TotalSpace.mk' ComplementModel (E := C₁) 1 (standardNormal 1))).2 : Plane) := by
  intro h
  apply movingNormal_zero_ne_one
  have hzero := congrArg
    (fun p : TotalSpace ComplementModel C₂ ↦ (Subtype.val (TotalSpace.snd p) : Plane))
    (comparison_normal 0)
  have hone := congrArg
    (fun p : TotalSpace ComplementModel C₂ ↦ (Subtype.val (TotalSpace.snd p) : Plane))
    (comparison_normal 1)
  exact hzero.symm.trans (h.trans hone)

/-- Equal-metric comparisons fix the chosen nonzero vectors for both metrics. -/
example (t : ℝ) :
    standardMetric.orthogonalComplementHomeomorph (G := Line) standardMetric S
        (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
        (TotalSpace.mk' ComplementModel (E := C₁) t (standardNormal t)) =
      TotalSpace.mk' ComplementModel (E := C₁) t (standardNormal t) ∧
    shearMetric.orthogonalComplementHomeomorph (G := Line) shearMetric S
        (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
        (TotalSpace.mk' ComplementModel (E := C₂) t (shearedNormal t)) =
      TotalSpace.mk' ComplementModel (E := C₂) t (shearedNormal t) := by
  constructor
  · have h := standardMetric.orthogonalComplementHomeomorph_refl (G := Line) S
      (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
    exact congrArg
      (fun f : @Homeomorph (TotalSpace ComplementModel C₁)
          (TotalSpace ComplementModel C₁) tC₁ tC₁ ↦
        f (TotalSpace.mk' ComplementModel (E := C₁) t (standardNormal t))) h
  · have h := shearMetric.orthogonalComplementHomeomorph_refl (G := Line) S
      (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
    exact congrArg
      (fun f : @Homeomorph (TotalSpace ComplementModel C₂)
          (TotalSpace ComplementModel C₂) tC₂ tC₂ ↦
        f (TotalSpace.mk' ComplementModel (E := C₂) t (shearedNormal t))) h

/-- The three-metric law gives the same concrete round trip as the two calculated
projection values, without introducing a second fixture. -/
example (t : ℝ) :
    shearMetric.orthogonalComplementHomeomorph (G := Line) standardMetric S
        (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
        (comparison (TotalSpace.mk' ComplementModel (E := C₁) t (standardNormal t))) =
      TotalSpace.mk' ComplementModel (E := C₁) t (standardNormal t) := by
  have h := standardMetric.orthogonalComplementHomeomorph_trans (G := Line)
    shearMetric standardMetric S (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
  have hr := standardMetric.orthogonalComplementHomeomorph_refl (G := Line) S
    (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)
  change (@Homeomorph.trans (TotalSpace ComplementModel C₁)
    (TotalSpace ComplementModel C₂) (TotalSpace ComplementModel C₁) tC₁ tC₂ tC₁
    (standardMetric.orthogonalComplementHomeomorph (G := Line) shearMetric S
      (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ))
    (shearMetric.orthogonalComplementHomeomorph (G := Line) standardMetric S
      (CoordinateLineBundle.isEmbedding_inclusion ℝ ℝ)))
    (TotalSpace.mk' ComplementModel (E := C₁) t (standardNormal t)) = _
  exact congrArg
    (fun f : @Homeomorph (TotalSpace ComplementModel C₁)
        (TotalSpace ComplementModel C₁) tC₁ tC₁ ↦
      f (TotalSpace.mk' ComplementModel (E := C₁) t (standardNormal t))) (h.trans hr)

/-- For the zero submodule, the fiber comparison fixes every ambient
vector, as follows from its difference-in-the-submodule API. -/
example (t : ℝ)
    (c : (⊥ : Submodule ℝ Plane).orthogonalBilin (standardMetric.inner t).toLinearMap₁₂) :
    (standardMetric.orthogonalComplementEquiv shearMetric (fun _ ↦ ⊥) t c : Plane) =
      (c : Plane) := by
  have h := standardMetric.orthogonalComplementEquiv_sub_mem shearMetric (fun _ ↦ ⊥) t c
  have hz : (c : Plane) -
      (standardMetric.orthogonalComplementEquiv shearMetric (fun _ ↦ ⊥) t c : Plane) = 0 := by
    simpa only [Submodule.mem_bot] using h
  exact (sub_eq_zero.mp hz).symm

/-- For the whole submodule, positivity forces the returned complement vector
to be zero. This does not assume a positive complement rank. -/
example (t : ℝ)
    (c : (⊤ : Submodule ℝ Plane).orthogonalBilin (standardMetric.inner t).toLinearMap₁₂) :
    standardMetric.orthogonalComplementEquiv shearMetric (fun _ ↦ ⊤) t c = 0 := by
  let d := standardMetric.orthogonalComplementEquiv shearMetric (fun _ ↦ ⊤) t c
  change d = 0
  apply Subtype.ext
  change (d : Plane) = 0
  have hd := d.property
  change (∀ s ∈ (⊤ : Submodule ℝ Plane), shearForm t s (d : Plane) = 0) at hd
  have hself := hd (d : Plane) (Submodule.mem_top)
  by_contra hn
  have hp := shearForm_pos t (d : Plane) hn
  simp only [hself, map_zero, lt_self_iff_false] at hp

end ShearMetricComparison

section EmptyBase

universe uG

open ShearMetricComparison

variable {G : Type uG} [NormedAddCommGroup G] [NormedSpace ℝ G]
  (g₁ g₂ : ContinuousHermitianMetric ℝ Plane (Bundle.Trivial Empty Plane))
  (S₀ : ∀ _ : Empty, Submodule ℝ Plane)
  [TopologicalSpace (TotalSpace G (fun b ↦ S₀ b))]
  [FiberBundle G (fun b ↦ S₀ b)] [VectorBundle ℝ G (fun b ↦ S₀ b)]
  (hS : Topology.IsEmbedding
    (fun p : TotalSpace G (fun b ↦ S₀ b) ↦
      TotalSpace.mk' Plane (E := Bundle.Trivial Empty Plane) (TotalSpace.proj p)
        (Subtype.val (TotalSpace.snd p))))

local notation "H₀" => EuclideanSpace ℝ (Fin (Module.finrank ℝ Plane - Module.finrank ℝ G))
local notation "C₀₁" => (fun b : Empty ↦ Subtype (fun v : Plane ↦ v ∈ Submodule.orthogonalBilin
  (ContinuousLinearMap.toLinearMap₁₂ (ContinuousHermitianMetric.inner g₁ b)) (S₀ b)))
local notation "C₀₂" => (fun b : Empty ↦ Subtype (fun v : Plane ↦ v ∈ Submodule.orthogonalBilin
  (ContinuousLinearMap.toLinearMap₁₂ (ContinuousHermitianMetric.inner g₂ b)) (S₀ b)))
local notation "tC₀₁" => TopologicalSpace.induced
  (fun p : TotalSpace H₀ C₀₁ ↦
    TotalSpace.mk' Plane (E := Bundle.Trivial Empty Plane) (TotalSpace.proj p)
      (Subtype.val (TotalSpace.snd p))) inferInstance
local notation "tC₀₂" => TopologicalSpace.induced
  (fun p : TotalSpace H₀ C₀₂ ↦
    TotalSpace.mk' Plane (E := Bundle.Trivial Empty Plane) (TotalSpace.proj p)
      (Subtype.val (TotalSpace.snd p))) inferInstance

/-- Over the empty base the comparison homeomorphism agrees with the reversed
comparison's inverse, for an arbitrary independent normed intrinsic model. No
global intrinsic finiteness or nonempty-base hypothesis is used. -/
example :
    g₁.orthogonalComplementHomeomorph (G := G) g₂ S₀ hS =
      @Homeomorph.symm (TotalSpace H₀ C₀₂) (TotalSpace H₀ C₀₁) tC₀₂ tC₀₁
        (g₂.orthogonalComplementHomeomorph (G := G) g₁ S₀ hS) := by
  refine @Homeomorph.ext (TotalSpace H₀ C₀₁) (TotalSpace H₀ C₀₂) tC₀₁ tC₀₂ _ _ ?_
  intro p
  exact Empty.elim (TotalSpace.proj p)

local notation "h₀" => (fun b : Empty ↦
  (Empty.elim b : Submodule.IsTopCompl (S₀ b) (Submodule.orthogonalBilin
    (ContinuousLinearMap.toLinearMap₁₂ (ContinuousHermitianMetric.inner g₁ b)) (S₀ b))))

/-- All three projector-field assertions allow an empty base with an arbitrary
normed intrinsic model, without a global finite-dimensionality assumption on it. -/
example :
    @Continuous Empty _ inferInstance
      (Bundle.ContinuousLinearMap.topologicalSpaceTotalSpace (RingHom.id ℝ)
        Plane (Bundle.Trivial Empty Plane) G (fun b ↦ S₀ b))
      (fun b ↦ TotalSpace.mk' (Plane →L[ℝ] G) b
        ((S₀ b).projectionOntoL _ (h₀ b))) ∧
    @Continuous Empty _ inferInstance
      (Bundle.ContinuousLinearMap.topologicalSpaceTotalSpace (RingHom.id ℝ)
        Plane (Bundle.Trivial Empty Plane) Plane (Bundle.Trivial Empty Plane))
      (fun b ↦ TotalSpace.mk' (Plane →L[ℝ] Plane) b
        ((S₀ b).projectionL _ (h₀ b))) ∧
    @Continuous Empty _ inferInstance
      (Bundle.ContinuousLinearMap.topologicalSpaceTotalSpace (RingHom.id ℝ)
        Plane (Bundle.Trivial Empty Plane) Plane (Bundle.Trivial Empty Plane))
      (fun b ↦ TotalSpace.mk' (Plane →L[ℝ] Plane) b
        ((Submodule.orthogonalBilin
          (ContinuousLinearMap.toLinearMap₁₂ (ContinuousHermitianMetric.inner g₁ b))
          (S₀ b)).projectionL (S₀ b) (h₀ b).symm)) := by
  exact ⟨g₁.continuous_orthogonalProjectionOntoL (G := G) S₀ hS,
    g₁.continuous_orthogonalProjectionL (G := G) S₀ hS,
    g₁.continuous_orthogonalComplementProjectionL (G := G) S₀ hS⟩

end EmptyBase
